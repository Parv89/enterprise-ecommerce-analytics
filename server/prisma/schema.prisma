generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  name          String
  role          String         @default("CUSTOMER") // CUSTOMER, MANAGER, ADMIN
  phone         String?
  avatar        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orders        Order[]
  reviews       Review[]
  auditLogs     AuditLog[]
  notifications Notification[]
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id             String      @id @default(uuid())
  name           String
  slug           String      @unique
  description    String
  price          Float
  compareAtPrice Float?
  stock          Int         @default(0)
  sku            String      @unique
  images         String      // JSON string array of URLs
  isFeatured     Boolean     @default(false)
  ratingsAvg     Float       @default(0.0)
  ratingsCount   Int         @default(0)
  categoryId     String
  category       Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]
  reviews        Review[]
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String      @default("PENDING") // PENDING, PAID, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  totalAmount     Float
  shippingAddress String      // JSON string (street, city, state, zip, country)
  paymentMethod   String      @default("STRIPE")
  paymentStatus   String      @default("PENDING") // PENDING, COMPLETED, FAILED, REFUNDED
  trackingNumber  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
  payments        Payment[]
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Int
  unitPrice  Float
  totalPrice Float
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactionId String   @unique
  amount        Float
  status        String   // SUCCEEDED, PENDING, FAILED
  provider      String   @default("STRIPE")
  details       String?  // JSON string
  createdAt     DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model FileStorage {
  id           String   @id @default(uuid())
  originalName String
  filename     String   @unique
  mimeType     String
  size         Int
  url          String
  createdAt    DateTime @default(now())
}
